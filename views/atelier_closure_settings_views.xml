<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atelier_closure_settings_form" model="ir.ui.view">
        <field name="name">ar.atelier.closure.settings.form</field>
        <field name="model">ar.atelier.closure.settings</field>
        <field name="arch" type="xml">
            <form string="Durée de clôture">
                <group><field name="minutes"/></group>
                <p>Cette durée s’applique aux quatre menus, y compris aux sessions en cours.</p>
                <footer>
                    <button name="action_save" type="object" string="Enregistrer" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
